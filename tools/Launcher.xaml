<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forza Motorsport 2 · Launcher" Width="880" Height="700" MinWidth="800" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#101012" Foreground="#F3F1EC" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#252527"/><Setter Property="Foreground" Value="#F3F1EC"/>
      <Setter Property="BorderBrush" Value="#505052"/><Setter Property="Padding" Value="9,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#E8E5DF"/><Setter Property="Foreground" Value="#191919"/>
      <Setter Property="BorderBrush" Value="#68645E"/><Setter Property="Padding" Value="9,6"/>
      <Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#191919"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#313133"/><Setter Property="Foreground" Value="#F3F1EC"/>
      <Setter Property="BorderBrush" Value="#505052"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
            <ContentPresenter RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFB35F"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F3F1EC"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="15"/></Style>
  </Window.Resources>
  <Grid x:Name="Surface" Background="#101012">
    <Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="#F1A248" BorderThickness="0,0,0,2">
      <Border.Background><LinearGradientBrush StartPoint="0,0.6" EndPoint="1,0.2"><GradientStop Color="#D1760F" Offset="0"/><GradientStop Color="#AB280A" Offset="0.55"/><GradientStop Color="#490D0C" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid Margin="30,18">
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="FORZA" FontSize="49" FontWeight="Black" FontStyle="Italic" Foreground="#EEEDE9"/>
            <TextBlock Text="2" FontSize="56" FontWeight="Black" FontStyle="Italic" Foreground="#FFB144" Margin="8,-8,0,0"/>
          </StackPanel>
          <TextBlock Text="MOTORSPORT" FontSize="18" FontStyle="Italic" FontWeight="Bold" Foreground="#E2DED7"/>
          <TextBlock Text="PC LAUNCHER" FontSize="10" Foreground="#FFD3A0" Margin="0,6,0,0"/>
        </StackPanel>
        <Viewbox Width="340" Height="80" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" IsHitTestVisible="False">
          <Canvas Width="460" Height="108">
            <Path Stroke="#FFD877" StrokeThickness="2.5" Data="M 2,76 C 34,57 52,48 92,47 L 132,44 C 177,8 210,10 261,14 L 331,33 362,39 C 401,39 431,48 451,62 L 460,80 M 6,87 C 95,91 284,88 456,86 M 145,43 L 306,41 M 47,64 L 91,59 M 347,55 L 431,57"/>
            <Ellipse Width="56" Height="56" Stroke="#FFD877" StrokeThickness="2" Canvas.Left="72" Canvas.Top="50"/>
            <Ellipse Width="56" Height="56" Stroke="#FFD877" StrokeThickness="2" Canvas.Left="348" Canvas.Top="50"/>
          </Canvas>
        </Viewbox>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="30,16,30,12">
        <TextBlock Text="SET UP YOUR DRIVE" FontSize="13" FontWeight="SemiBold" Foreground="#F6AC58" Margin="0,0,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <CheckBox x:Name="VSync" Grid.Column="0" Content="_VSync" AutomationProperties.Name="VSync" Margin="0,0,0,16" ToolTip="Use the SDK vertical-sync setting. The FPS cap remains separate."/>
          <CheckBox x:Name="Fullscreen" Grid.Column="2" Content="_Fullscreen" AutomationProperties.Name="Fullscreen" Margin="0,0,0,16" ToolTip="Fullscreen uses the monitor size. Resolution below sets the window size."/>
          <StackPanel Grid.Row="1" Grid.Column="0"><Label Target="{Binding ElementName=Resolution}" Content="_Window resolution" Foreground="#C7C4BD" Padding="0,0,0,6"/><ComboBox x:Name="Resolution" IsEditable="True" AutomationProperties.Name="Window resolution"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2"><Label Target="{Binding ElementName=MaxFps}" Content="Ma_ximum FPS" Foreground="#C7C4BD" Padding="0,0,0,6"/><ComboBox x:Name="MaxFps" IsEditable="True" AutomationProperties.Name="Maximum FPS"/></StackPanel>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Fullscreen uses your monitor's resolution." Foreground="#A8A49C" FontSize="11" Margin="0,6,0,12"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="A ceiling, independent of VSync. Does not unlock game FPS." Foreground="#A8A49C" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12"/>
        </Grid>
        <Label Target="{Binding ElementName=Scale}" Content="Render _scale / supersampling" Foreground="#C7C4BD" Padding="0,0,0,6"/>
        <ComboBox x:Name="Scale" AutomationProperties.Name="Render scale"/>
        <TextBlock x:Name="ScaleNote" Foreground="#A8A49C" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,12"/>
        <Border BorderBrush="#3C3730" BorderThickness="0,1,0,0" Padding="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions>
            <Label Content="_Build" Target="{Binding ElementName=ExecutablePath}" Foreground="#C7C4BD" VerticalAlignment="Center" Padding="0"/>
            <TextBox x:Name="ExecutablePath" Grid.Column="1" Margin="0,2,8,2" FontSize="11" AutomationProperties.Name="FM2 executable"/>
            <Button x:Name="BrowseBuild" Grid.Column="2" Content="Browse" Margin="0,2,0,2" AutomationProperties.Name="Browse FM2 executable"/>
            <Label Grid.Row="1" Content="_Game files" Target="{Binding ElementName=GameDataRoot}" Foreground="#C7C4BD" VerticalAlignment="Center" Padding="0"/>
            <TextBox x:Name="GameDataRoot" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" FontSize="11" AutomationProperties.Name="Game files folder"/>
            <Button x:Name="BrowseGame" Grid.Row="1" Grid.Column="2" Content="Browse" Margin="0,2,0,2" AutomationProperties.Name="Browse game files folder"/>
            <Label Grid.Row="2" Content="_Profile" Target="{Binding ElementName=UserDataRoot}" Foreground="#C7C4BD" VerticalAlignment="Center" Padding="0"/>
            <TextBox x:Name="UserDataRoot" Grid.Row="2" Grid.Column="1" Margin="0,2,8,2" FontSize="11" AutomationProperties.Name="Profile folder"/>
            <Button x:Name="BrowseUser" Grid.Row="2" Grid.Column="2" Content="Browse" Margin="0,2,0,2" AutomationProperties.Name="Browse profile folder"/>
            <Label Grid.Row="3" Content="_Content" Target="{Binding ElementName=ContentRoot}" Foreground="#C7C4BD" VerticalAlignment="Center" Padding="0"/>
            <TextBox x:Name="ContentRoot" Grid.Row="3" Grid.Column="1" Margin="0,2,8,2" FontSize="11" ToolTip="Optional extracted marketplace packages folder." AutomationProperties.Name="Optional content folder"/>
            <Button x:Name="BrowseContent" Grid.Row="3" Grid.Column="2" Content="Browse" Margin="0,2,0,2" AutomationProperties.Name="Browse content folder"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#3C3730" BorderThickness="0,1,0,0" Background="#171719" Padding="30,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="112"/><ColumnDefinition Width="16"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#AAA69D" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Button x:Name="Save" Grid.Column="2" Content="_Save" ToolTip="Remember settings without starting the game."/>
        <Button x:Name="Start" Grid.Column="4" Background="#C95112" BorderBrush="#F39437" IsDefault="True" AutomationProperties.Name="Start FM2">
          <StackPanel Orientation="Horizontal"><Border CornerRadius="16" Background="#54A929" Width="25" Height="25" Margin="0,0,12,0"><TextBlock Text="A" Foreground="#152F05" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="START FM2" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
