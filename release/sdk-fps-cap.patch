+++ b/src/graphics/frame_pacer.h
@@ -0,0 +1,37 @@
+// Host frame-swap pacing; independent of guest clocks and vblank frequency.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+
+namespace rex::graphics {
+
+class FramePacer {
+ public:
+  using Clock = std::chrono::steady_clock;
+
+  template <typename Now, typename Sleep>
+  void Wait(int32_t fps, Now now, Sleep sleep) {
+    auto current = now();
+    if (fps <= 0 || fps != fps_) {
+      fps_ = fps;
+      last_swap_ = current;
+      return;
+    }
+    const auto interval = std::chrono::ceil<Clock::duration>(
+        std::chrono::duration<double>(1.0 / fps));
+    const auto deadline = last_swap_ + interval;
+    while (current < deadline) {
+      sleep(std::chrono::ceil<std::chrono::microseconds>(deadline - current));
+      current = now();
+    }
+    // Late frames restart the schedule; never issue catch-up bursts.
+    last_swap_ = current;
+  }
+
+ private:
+  int32_t fps_ = 0;
+  Clock::time_point last_swap_{};
+};
+
+}  // namespace rex::graphics
