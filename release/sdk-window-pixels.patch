diff --git a/src/ui/window_size.h b/src/ui/window_size.h
new file mode 100644
--- /dev/null
+++ b/src/ui/window_size.h
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <cstdint>
+#include <utility>
+
+namespace rex::ui {
+
+// Keep the normal logical-size conversion, or bypass it for explicit pixel sizes.
+template <typename ToPhysical>
+std::pair<uint32_t, uint32_t> StartupWindowSize(uint32_t width, uint32_t height,
+                                               bool pixels, ToPhysical to_physical) {
+  if (pixels) return {width, height};
+  return {to_physical(width), to_physical(height)};
+}
+
+}  // namespace rex::ui
